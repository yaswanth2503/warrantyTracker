extends layout

block content
	.container.d-flex.justify-content-center.align-items-center(style="min-height: 100vh;")
		.card.shadow.p-4(style="width: 400px;")
			h2.text-center.mb-4 Login

			form#loginForm
				.mb-3
					label.form-label Username
					input.form-control(
						type="text",
						name="username",
						placeholder="Enter username",
						autocomplete="off"
						required
					)

				.mb-3
					label.form-label Password
					input.form-control(
						type="password",
						name="password",
						placeholder="Enter password",
						autocomplete="off"
						required
					)

				button.btn.btn-primary.w-100(type="submit")
					| Login

			p.text-center.mt-3
				| Don't have an account?
				a.ms-1(href="/register") Register

block scripts
	script(src='/js/login.js')